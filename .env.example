# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# MongoDB connection URI (e.g., mongodb://localhost:27017/bookleaf or MongoDB Atlas URI)
# If empty or unavailable, local embedded MongoDB starts automatically for seamless development
MONGODB_URI=mongodb://localhost:27017/bookleaf

# Authentication Secrets
JWT_SECRET=bookleaf_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=bookleaf_cookie_signing_secret_key

# Admin Seed Defaults (Used by npm run seed)
DEFAULT_ADMIN_EMAIL=admin@bookleaf.com
DEFAULT_ADMIN_PASSWORD=Admin@BookLeaf2025
DEFAULT_AUTHOR_PASSWORD=BookLeaf@2025

# AI Integration Configuration
# Supported providers: mock, openai, gemini, anthropic
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
